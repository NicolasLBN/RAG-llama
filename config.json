{
  "chunking": {
    "min_chars": 160,
    "max_chars": 900,
    "overlap_chars": 140,
    "min_native_chars": 80,
    "min_image_area_ratio": 0.04,
    "toc_dot_lines": 8
  },
  "ingest": {
    "batch_size": 8,
    "ocr_dpi": 200
  },
  "embedding": {
    "query_prefix": "query: ",
    "document_prefix": ""
  },
  "search": {
    "fetch_k": 30,
    "final_k": 4,
    "exact_weight": 0.40,
    "lexical_weight": 0.25,
    "semantic_weight": 0.35,
    "min_semantic_score": 0.28,
    "min_final_score": 0.32,
    "enrich_query": false
  },
  "generation": {
    "temperature": 0.0,
    "max_tokens": 280,
    "timeout_s": 180
  },
  "logging": {
    "level": "INFO",
    "file": "logs/rag.log"
  }
}
